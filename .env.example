# Convex deployment the app reads/writes. Production is dusty-ox-307 —
# see README Deployment before changing either value.
CONVEX_URL=
CONVEX_DEPLOYMENT=

# Dune Analytics API key. The scheduled sync no longer uses Dune — this is
# needed only by POST /api/backfill, the last remaining consumer.
# Free key at: https://dune.com/settings/api
DUNE_API_KEY=your_dune_api_key

# Optional: dedicated Dune query ID for admin historical backfills.
# The query must accept window_start and window_end parameters.
DUNE_BACKFILL_QUERY_ID=

# Required by POST /api/backfill. Set to a long random secret and send it as
# the x-admin-refresh-token request header. Leave blank to disable the endpoint.
# Never expose this to the browser.
ADMIN_REFRESH_TOKEN=
